# cp .env.example .env && chmod 600 .env   (never commit .env)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
OFFICE_GROUP_ID=            # object id of the Entra group AI-Office-Users
ADMIN_USERS=                # comma-separated sign-in names (Phase 1: the owner)
SESSION_SECRET=             # openssl rand -hex 32  (at least 32 bytes / 64 hex chars)
PUBLIC_URL=                 # exactly the browser origin, e.g. https://office.example.com (no path)
# DATA_DIR=/data
# PORT=8080
