# cp .env.example .env && chmod 600 .env   (never commit .env)
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# object id of the Entra group AI-Office-Users
OFFICE_GROUP_ID=
# comma-separated Entra Object IDs (oid) of admins, not sign-in names (Phase 1: the owner)
ADMIN_USERS=
# openssl rand -hex 32  (at least 32 bytes / 64 hex chars)
SESSION_SECRET=
# exactly the browser origin, e.g. https://office.example.com (no path)
PUBLIC_URL=
# DATA_DIR=/data
# PORT=8080
