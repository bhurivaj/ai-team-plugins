# Copy to .env (chmod 600). Never commit .env.
ANTHROPIC_API_KEY=
# Entra ID app registration of the bot (single tenant)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# Comma-separated Entra object IDs allowed to use the bot (Phase 0: the owner only). Empty = nobody.
ALLOWED_USERS=
# Which company folder a Teams channel works on: <channel conversation id>=<company>, comma-separated
CHANNEL_COMPANY_MAP=
DEFAULT_COMPANY=catice
BOT_MODEL=claude-sonnet-5-5
MAX_BUDGET_USD=0.50
