# /etc/nginx/sites-available/ai-bot  — behind Cloudflare (proxied DNS, SSL mode Full (strict))
server {
    listen 443 ssl;
    server_name ai-bot.example.com;                      # your bot host
    ssl_certificate     /etc/ssl/cloudflare/origin.pem;   # Cloudflare origin certificate
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    location = /api/messages {
        proxy_pass http://127.0.0.1:3978;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 20m;     # photo attachments (Phase 1+)
        proxy_read_timeout 30s;       # the bot answers fast; long work is sent proactively
    }
    location / { return 404; }        # nothing else is exposed
}
