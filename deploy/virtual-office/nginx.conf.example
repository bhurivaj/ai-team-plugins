# /etc/nginx/sites-available/office  — behind Cloudflare (proxied DNS, SSL mode Full (strict)).
# A Cloudflare Access application fronts this hostname; nothing reaches nginx without passing it.
server {
    listen 443 ssl;
    server_name office.example.com;                      # your office host = PUBLIC_URL host
    ssl_certificate     /etc/ssl/cloudflare/origin.pem;   # Cloudflare origin certificate
    ssl_certificate_key /etc/ssl/cloudflare/origin.key;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;           # WebSocket (/ws)
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }
}
